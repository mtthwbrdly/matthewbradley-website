---
import { urlFor } from "../lib/sanity";
const { work } = Astro.props;
const overlayId = `work-overlay-${work.slug}`;
import { PortableText } from '@portabletext/react';

const getImageSrc = (it, width = 1800) => {
  if (!it) return null
  // If the asset already contains a direct url (asset-> was used), prefer it
  if (it.asset && it.asset.url) return it.asset.url
  // If the item itself is an image object, pass it to urlFor
  try {
    if (it._type === 'image') return urlFor(it).width(width).quality(90).auto('format').url()
    // If asset is a reference object {_ref: 'image-...'}, wrap and pass
    if (it.asset && it.asset._ref) return urlFor({asset: it.asset}).width(width).quality(90).auto('format').url()
    // Fallback: try passing the asset object directly
    if (it.asset) return urlFor(it.asset).width(width).quality(90).auto('format').url()
  } catch (e) {
    return null
  }
  return null
}
---
<div class="work-overlay" data-slug={work.slug} id={overlayId}>
  <div class="overlay-content">
    <!-- Close Button -->
    <button class="work-detail difference" aria-label="Close"><h1>{work.title}</h1></button>
    
    <!-- Information Button --> 
    {work.description && work.description.length > 0 && (
      <button class="info-button difference" aria-label="Information">Information</button>
    )}
  

    <div class="content-wrapper">
    <!-- Swiper -->
    {work.gallery && work.gallery.length > 0 && (
      <div class="swiper fullscreen-swiper">
        <div class="swiper-wrapper">
          {(() => {
            // normalize gallery into slides: if entry is a slide (has items) use it, otherwise wrap old items
            const slides = (work.gallery || []).map((entry) => {
              if (entry && (entry._type === 'gallerySlide' || entry.items)) {
                  const items = (entry.items || []).filter(Boolean).map((it) => ({
                    ...it,
                    displayMode: it?.displayMode || 'fullscreen',
                    isVideo: !!it?.isVideo || it?._type === 'file' || it?._type === 'video',
                    videoUrl: it?.videoUrl || it?.asset?.url,
                  }))
                  return { layout: entry.layout || 'single', items }
              }
                const item = entry ? {
                  ...entry,
                  displayMode: entry.displayMode || 'fullscreen',
                  isVideo: !!entry.isVideo || entry._type === 'file' || entry._type === 'video',
                  videoUrl: entry.videoUrl || entry.asset?.url,
                } : null
              return { layout: 'single', items: [item] }
            })

            return slides.map((slide) => (
              <div class="swiper-slide">
                {slide.layout === 'two-up' || slide.layout === 'grid' ? (
                  <div class={`slide-grid slide-grid--${slide.layout}`}>
                    { (slide.items || []).filter(Boolean).map((it) => (
                      it && it.isVideo ? (
                        <video
                          playsinline
                          preload="metadata"
                          muted
                          autoplay
                          loop
                          class={`project-video project-video--${it.displayMode === 'inset' ? 'inset' : it.displayMode === 'contained' ? 'contained' : 'fullscreen'}`}
                        >
                          <source src={it.videoUrl || it.asset?.url} type="video/mp4" />
                        </video>
                      ) : (
                        it.asset && (
                          <img
                            src={getImageSrc(it, 1800)}
                            alt={it.caption || work.title}
                            loading="lazy"
                            class={`gallery-image blur-up ${it.displayMode === 'inset' ? 'gallery-image--inset' : 'gallery-image--fullscreen'}`}
                            style={it.lqip ? `background-image:url(${it.lqip});background-size:cover` : ''}
                          />
                        )
                      )
                    ))}
                  </div>
                ) : (
                  // single layout: show first item
                  (() => {
                    const it = (slide.items || [])[0]
                    if (!it) return null
                    return it.isVideo ? (
                      <video
                        playsinline
                        preload="metadata"
                        muted
                        autoplay
                        loop
                        class={`project-video project-video--${it.displayMode === 'inset' ? 'inset' : it.displayMode === 'contained' ? 'contained' : 'fullscreen'}`}
                      >
                        <source src={it.videoUrl || it.asset?.url} type="video/mp4" />
                      </video>
                      ) : (
                          it.asset && (
                            <img
                              src={getImageSrc(it, 2400)}
                              alt={it.caption || work.title}
                              loading="lazy"
                              class={`gallery-image blur-up gallery-image--${it.displayMode === 'inset' ? 'inset' : it.displayMode === 'contained' ? 'contained' : 'fullscreen'}`}
                              style={it.lqip ? `background-image:url(${it.lqip});background-size:contain;background-repeat: no-repeat;` : ''}
                            />
                          )
                      )
                  })()
                )}
              </div>
            ))
          })()}
        </div>
        <div class="swiper-pagination"></div>
      </div>
      <div class="swiper-controls">
        <button class="swiper-button-prev"></button>
        <button class="swiper-button-next"></button>
      </div>
    )}
  </div>

<!-- Information Panel -->
{work.description && work.description.length > 0 && (
<div class="info-panel">
  <div class="info-panel__content">
    <PortableText value={work.description} />
    <button class="info-close" aria-label="Close Information">(Hide)</button>
  </div>
</div>
)}

</div>

<script is:inline define:vars={{ overlayId }}>
  document.addEventListener("DOMContentLoaded", () => {
    const overlay = document.getElementById(overlayId);
    const swiperContainer = overlay?.querySelector(".fullscreen-swiper");
    let wheelHandlerAttached = false;

    if (swiperContainer) {
      const attachWheelNavigation = (swiper) => {
        if (wheelHandlerAttached) return;

        let wheelLock = false;
        let wheelDelta = 0;
        let wheelGestureTimeout;
        const releaseWheelLock = () => {
          wheelLock = false;
          wheelDelta = 0;
        };

        const isScrollableElement = (element) => {
          if (!(element instanceof HTMLElement)) return false;
          return (
            element.scrollHeight > element.clientHeight &&
            getComputedStyle(element).overflowY !== "visible"
          );
        };

        const shouldIgnoreWheel = (event) => {
          if (!overlay.classList.contains("active")) return true;

          const target = event.target;
          if (!(target instanceof HTMLElement)) return false;

          const infoPanel = target.closest(".info-panel");
          if (!infoPanel) return false;

          let current = target;
          while (current && current !== infoPanel) {
            if (isScrollableElement(current)) return true;
            current = current.parentElement;
          }

          return isScrollableElement(infoPanel);
        };

        const handleWheel = (event) => {
          if (shouldIgnoreWheel(event)) return;

          const primaryDelta =
            Math.abs(event.deltaX) > Math.abs(event.deltaY)
              ? event.deltaX
              : event.deltaY;

          if (Math.abs(primaryDelta) < 8) return;

          event.preventDefault();
          wheelDelta += primaryDelta;

          window.clearTimeout(wheelGestureTimeout);
          wheelGestureTimeout = window.setTimeout(releaseWheelLock, 180);

          if (wheelLock || Math.abs(wheelDelta) < 40) return;

          wheelLock = true;

          if (wheelDelta > 0) {
            swiper.slideNext();
          } else {
            swiper.slidePrev();
          }
        };

        swiperContainer.addEventListener("wheel", handleWheel, {
          passive: false,
        });
        wheelHandlerAttached = true;
      };

      const initSwiper = () => {
        if (swiperContainer.swiper) return;
        if (typeof Swiper === "undefined") {
          console.warn("Swiper not loaded yet");
          return;
        }
        const swiper = new Swiper(swiperContainer, {
          loop: true,
          effect: "slide",
          speed: 400,
          spaceBetween: 4,
 navigation: {
  nextEl: overlay.querySelector(".swiper-button-next"),
  prevEl: overlay.querySelector(".swiper-button-prev"),
},
          keyboard: { enabled: true },
        });

        attachWheelNavigation(swiper);
      };

      // Re-init when overlay becomes active
      const observer = new MutationObserver(() => {
        if (overlay.classList.contains("active")) initSwiper();
      });
      observer.observe(overlay, { attributes: true });
    }
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const overlays = document.querySelectorAll(".work-overlay");

    overlays.forEach((overlay) => {
      const infoBtn = overlay.querySelector(".info-button");
      const infoPanel = overlay.querySelector(".info-panel");
      const closeBtn = overlay.querySelector(".info-close");
      const contentWrapper = overlay.querySelector(".content-wrapper");

      if (!infoBtn || !infoPanel || !closeBtn || !contentWrapper) return;

      let isOpen = false;

      function openPanel() {
        isOpen = true;
        infoPanel.classList.add("active");
        contentWrapper.classList.add("panel-open");
        infoBtn.classList.add("hidden");
      }

      function closePanel() {
        isOpen = false;
        infoPanel.classList.remove("active");
        contentWrapper.classList.remove("panel-open");
        infoBtn.classList.remove("hidden");
      }

      infoBtn.addEventListener("click", () => {
        if (isOpen) closePanel();
        else openPanel();
      });

      closeBtn.addEventListener("click", closePanel);
    });
  });
</script>

<script>
  import { gsap } from "gsap";
  import { TextPlugin } from "gsap/TextPlugin";

  document.addEventListener("DOMContentLoaded", () => {
    gsap.registerPlugin(TextPlugin);

    const workDetails = document.querySelectorAll(".work-detail");

    workDetails.forEach((workDetail) => {
      const title = workDetail.querySelector("h1");
      const originalText = title.textContent;

      workDetail.addEventListener("mouseenter", () => {
        gsap.to(title, {
          duration: 1,
          text: "← Back to Works",
          ease: "power2.out",
        });
      });

      workDetail.addEventListener("mouseleave", () => {
        gsap.to(title, {
          duration: 1,
          text: originalText,
          ease: "power2.out",
          delay: 0.5,
        });
      });
    });
  });
</script>

</div>
