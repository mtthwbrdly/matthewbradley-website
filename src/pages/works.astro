---
import BaseLayout from "../layouts/BaseLayout.astro";
import { client, urlFor } from "../lib/sanity";
import WorkOverlay from "../components/WorkOverlay.astro";

// Fetch only what you need and flatten the slug to a string
const works = await client.fetch(`*[_type == "work"] | order(orderRank){
  title,
  client,
  year,
  clickable,
  description,
  pullquote,
  category,
thumbnail[]{
  _type,
  alt,
  "assetUrl": asset->url,
  "lqip": asset->metadata.lqip,
  "width": asset->metadata.dimensions.width,
  "height": asset->metadata.dimensions.height,
  asset->{_id,_type,url, "width": metadata.dimensions.width, "height": metadata.dimensions.height}
},
  gallery[]{
    _type,
    _key,
    "isVideo": _type in ["file", "video"],
    "displayMode": coalesce(displayMode, "fullscreen"),
    "videoUrl": select(_type in ["file", "video"] => asset->url, null),
    asset,
    layout,
    items[]{
      _type,
      _key,
      "isVideo": _type in ["file", "video"],
      "displayMode": coalesce(displayMode, "fullscreen"),
      "videoUrl": select(_type in ["file", "video"] => asset->url, null),
    asset,
    "lqip": asset->metadata.lqip,
    "width": asset->metadata.dimensions.width,
    "height": asset->metadata.dimensions.height
    }
  },
  "slug": slug.current
}`);


---
<script define:vars={{ works }}>
  console.log("Works data:", works);
</script>
<BaseLayout title="Work">
  <Fragment slot="head">
    <script is:inline>
      try {
        const savedView = localStorage.getItem("view") || "list";
        document.documentElement.dataset.workView = savedView;
      } catch {
        document.documentElement.dataset.workView = "list";
      }
    </script>
  </Fragment>
  <nav class="work-filters" aria-label="Filter works">
    <button class="page-title work-filter is-active" type="button" data-filter="all"><span class="page-title-label">Works</span></button>
    <button class="work-filter" type="button" data-filter="identity">Identities</button>
    <button class="work-filter" type="button" data-filter="website">Websites</button>
    <button class="work-filter" type="button" data-filter="book">Books</button>
    <button class="work-filter" type="button" data-filter="other">Other</button>
  </nav>

  <section class="works-section">
    <div class="work-list">
      {
        works.map((work) => {
          const isClickable = work.clickable !== false;
          const Tag = isClickable ? 'a' : 'div';
          return (
          <Tag class:list={["work-link", { "work-link--static": !isClickable }]} href={isClickable ? "#" : undefined} data-slug={isClickable ? work.slug : undefined} data-has-pullquote={work.pullquote ? "true" : "false"} data-categories={work.category?.join(" ") || ""}>
            <div class="work-item">
              {work.thumbnail &&
                work.thumbnail.length > 0 &&
                (work.thumbnail[0]._type === "image" ? (
                  <img
              class="work-image blur-up"
              src={urlFor(work.thumbnail[0]).width(1600).quality(90).auto('format').url()}
              alt={work.thumbnail[0].alt || work.title}
              style={work.thumbnail[0].lqip ? `background-image:url(${work.thumbnail[0].lqip});background-size:cover;background-repeat:no-repeat;` : ''}
            />
                ) : work.thumbnail[0]._type === "video" ? (
                  <video
                    class={`gallery-video ${
                      work.thumbnail[0].displayMode === "inset"
                        ? "gallery-video--inset"
                        : "gallery-video--fullscreen"
                    }`}
                    src={
                      work.thumbnail[0].assetUrl ||
                      work.thumbnail[0].asset?.url ||
                      ""
                    }
                    autoplay
                    muted
                    loop
                    playsinline
                  />
                ) : null)}
              <div class="work-details">
                <span class="work-quote">{work.pullquote}</span>
                <span class="work-client">{work.client}</span>
                <span class="work-category">({work.category?.join(", ")})</span>
              </div>
            </div>
          </Tag>
        )})
      }
    </div>

    {works.filter((work) => work.clickable !== false).map((work) => <WorkOverlay work={work} />)}

    <div class="view-switcher">
      <button data-view="list" class="is-active">Word of mouth</button>/
      <button data-view="images">See for yourself</button>
    </div>
  </section>
  <script src="/src/scripts/viewSwitcher.js"></script>
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const links = document.querySelectorAll(".work-link");
      const overlays = document.querySelectorAll(".work-overlay");
      const body = document.body;

      links.forEach((link) => {
        link.addEventListener("click", (e) => {
          e.preventDefault();
          const slug = link.dataset.slug;
          const overlay = document.querySelector(
            `.work-overlay[data-slug="${slug}"]`
          );
          if (overlay) {
            overlay.classList.add("active");
            body.style.overflow = "hidden";
          }
        });
      });

      overlays.forEach((overlay) => {
        const close = overlay.querySelector(".work-detail");
        if (close) {
          close.addEventListener("click", () => {
            overlay.classList.remove("active");
            body.style.overflow = "";
          });
        }
      });
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        const activeOverlay = document.querySelector(".work-overlay.active");
        if (activeOverlay) {
          activeOverlay.classList.remove("active");
          document.body.style.overflow = "";
        }
      }
    });
  </script>
</BaseLayout>
