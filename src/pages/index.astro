---
import BaseLayout from "../layouts/BaseLayout.astro";
import { client, urlFor } from "../lib/sanity";

const works = await client.fetch(`*[_type == "home"]{
  category,
  title,
  thumbnail[]{
    _type,
    asset,
    "videoUrl": asset->url,
    "fileType": asset->mimeType,
    "dominantColor": asset->metadata.palette.dominant.background,
    "width": asset->metadata.dimensions.width,
    "height": asset->metadata.dimensions.height,
    poster,
    "posterDominantColor": poster.asset->metadata.palette.dominant.background,
    "posterWidth": poster.asset->metadata.dimensions.width,
    "posterHeight": poster.asset->metadata.dimensions.height,
  }
}`);

const categoryImages = {
  identity: [],
  website: [],
  book: [],
  other: [],
  title: [],
};

for (const work of works) {
  const categories = Array.isArray(work.category)
    ? work.category
    : [work.category || "other"];
  for (const cat of categories) {
    if (!categoryImages[cat]) categoryImages[cat] = [];
    if (work.thumbnail) {
      for (const thumb of work.thumbnail) {
        const title = work.title || thumb.title || "Untitled";
        if (thumb._type === "image" && thumb.asset) {
          categoryImages[cat].push({
            type: "image",
            url: urlFor(thumb.asset).width(800).url(),
            title,
            color: thumb.dominantColor || null,
            width: thumb.width || null,
            height: thumb.height || null,
          });
        }
        if (thumb._type === "video" && thumb.videoUrl) {
          let posterUrl = undefined;
          if (thumb.poster && thumb.poster.asset) {
            posterUrl = urlFor(thumb.poster.asset).width(800).url();
          }
          const videoColor =
            thumb.posterDominantColor || thumb.dominantColor || null;
          categoryImages[cat].push({
            type: "video",
            url: thumb.videoUrl,
            poster: posterUrl,
            title,
            color: videoColor,
            width: thumb.posterWidth || thumb.width || null,
            height: thumb.posterHeight || thumb.height || null,
          });
        }
      }
    }
  }
}
---

<BaseLayout>
  <section class="home" id="home-stack">
    <button class="info-button difference" aria-label="Information"
      >Information</button
    >
    <div class="caption-container difference">Full Website Coming Soon...</div>
    <!-- Information Panel -->
    <div class="info-panel">
      <div class="info-panel__content">
        <div class="contact-panel__text">
          <p>
           Matthew Bradley is a freelance graphic designer based in Cape Town, South Africa, specialising in visual identity design, website design and editorial projects. His practice spans visual identities, websites, publications and digital experiences, with a focus on working across disciplines and mediums.
          </p>
          <p>
        He collaborates closely with artists, designers, cultural institutions and small businesses to develop thoughtful, enduring visual systems. His work often moves between print and digital, from brand identities and websites to books, editorial design and exhibition materials, building cohesive worlds that translate across formats and contexts.
          </p>
          <p>
             Matthew works with clients in Cape Town and internationally, offering freelance graphic design and web design services for artists, designers and creative studios.
          </p>
                    <p>
            Clients include Stiebeuel, Lukhanyo Mdingi, MŪVEK, Brett Murray, Southern Guild, Rich Mnisi, Color C Design Studio, LOFT Editions and Chris van Niekerk, Norval Foundation, among others.
          </p>
          <p>
            <a href="mailto:hello@matthewbradley.info?subject=Portfolio Request"
              >Portfolio available on request.</a>
          </p>

          <div class="contact-panel__links">
            <div class="contact-panel__link">
              New business inquiries → <a
                href="mailto:hello@matthewbradley.info"
              >
                hello@matthewbradley.info</a
              >
            </div>
            <div class="contact-panel__link">
              Instagram → <a
                href="https://instagram.com/matthewbradley"
                target="_blank"
              >
                @matthewbradley</a
              >
            </div>

            <button class="info-close" aria-label="Close Information"
              >(Hide)</button
            >
          </div>
        </div>
      </div>
    </div>
    <div class="home-inner">
      <h1>
        <div class="link-container">
          <span href="">Identities,</span>
          <div
            class="link-images"
            data-images={JSON.stringify(categoryImages.identity)}
          >
          </div>
        </div>
        <div class="link-container">
          <span href="">Websites,</span>
          <div
            class="link-images"
            data-images={JSON.stringify(categoryImages.website)}
          >
          </div>
        </div>
        <div class="link-container">
          <span href="">Books,</span>
          <div
            class="link-images"
            data-images={JSON.stringify(categoryImages.book)}
          >
          </div>
        </div>
        <div class="link-container">
          <span href="">and other graphic solutions.</span>
          <div
            class="link-images"
            data-images={JSON.stringify(categoryImages.other)}
          >
          </div>
        </div>
      </h1>
    </div>

    <script>
      const homeStack = document.getElementById("home-stack");
      const mediaCache = {};
      const isMobile = window.matchMedia(
        "(hover: none) and (pointer: coarse)",
      ).matches;

      let activeMobileMedia = null;
      let activeMobileTimer = null;

      function hideMedia(elem) {
        if (!elem) return;
        elem.style.opacity = "0";
        setTimeout(() => {
          if (elem.tagName === "VIDEO") {
            elem.pause();
            elem.style.display = "none";
          } else if (elem.parentNode) {
            elem.parentNode.removeChild(elem);
          }
        }, 300);
      }

      function hideMobileMedia() {
        if (activeMobileTimer) {
          clearTimeout(activeMobileTimer);
          activeMobileTimer = null;
        }
        if (activeMobileMedia) {
          hideMedia(activeMobileMedia);
          activeMobileMedia = null;
        }
      }

      function getOrCreateMedia(item) {
        if (mediaCache[item.url]) return mediaCache[item.url];
        let elem;
        if (item.type === "image") {
          elem = document.createElement("img");
          elem.src = item.url;
          elem.decoding = "async";
          elem.decode().catch(() => {});
        } else {
          elem = document.createElement("video");
          elem.src = item.url;
          elem.muted = true;
          elem.loop = true;
          elem.playsInline = true;
          elem.preload = "auto";
          if (item.poster) elem.poster = item.poster;
        }
        elem.className = "home-stack-media";
        mediaCache[item.url] = elem;
        return elem;
      }

      function placeMedia(item) {
        const maxW = 600,
          maxH = 600;
        const iW = item.width || 600,
          iH = item.height || 400;
        const aspect = iW / iH;
        let dW = iW,
          dH = iH;
        if (dW > maxW) {
          dW = maxW;
          dH = Math.round(dW / aspect);
        }
        if (dH > maxH) {
          dH = maxH;
          dW = Math.round(dH * aspect);
        }
        const rect = homeStack.getBoundingClientRect();
        let left, top;
        if (isMobile) {
          left = (rect.width - dW) / 2;
          top = (rect.height - dH) / 2;
        } else {
          left = Math.random() * Math.max(0, rect.width - dW);
          top = Math.random() * Math.max(0, rect.height - dH);
        }

        let elem;
        if (item.type === "video") {
          elem = getOrCreateMedia(item);
          elem.style.display = "";
        } else {
          const cached = getOrCreateMedia(item);
          elem = cached.cloneNode(true);
          elem.className = "home-stack-media";
        }

        Object.assign(elem.style, {
          position: "absolute",
          zIndex: "2",
          pointerEvents: "none",
          width: `${dW}px`,
          height: `${dH}px`,
          objectFit: "contain",
          transition: "opacity 0.3s",
          opacity: "0",
          left: `${left}px`,
          top: `${top}px`,
        });

        if (!elem.parentNode) homeStack.appendChild(elem);

        if (item.type === "video") {
          elem.currentTime = 0;
          const playPromise = elem.play();
          if (playPromise) playPromise.catch(() => {});
        }

        const fadeIn = () => {
          elem.style.opacity = "1";
        };
        if (item.type === "image") {
          elem.decode().then(fadeIn).catch(fadeIn);
        } else {
          if (elem.readyState >= 2) {
            fadeIn();
          } else {
            elem.addEventListener("canplay", fadeIn, { once: true });
          }
        }
        return elem;
      }

      const allContainers = document.querySelectorAll(".link-container");
      const allItems = [];
      allContainers.forEach((c) => {
        const data = JSON.parse(
          c.querySelector(".link-images").getAttribute("data-images"),
        );
        allItems.push(...data);
      });
      const seen = new Set();
      allItems.forEach((item) => {
        if (!seen.has(item.url)) {
          seen.add(item.url);
          if (item.type === "image") {
            const link = document.createElement("link");
            link.rel = "preload";
            link.as = "image";
            link.href = item.url;
            document.head.appendChild(link);
          }
          getOrCreateMedia(item);
        }
      });

      allContainers.forEach((container) => {
        const link = container.querySelector("span");
        const images = JSON.parse(
          container.querySelector(".link-images").getAttribute("data-images"),
        );
        const caption = document.querySelector(".caption-container");

        let lastUrl = null;
        function pickRandom() {
          if (!images.length) return null;
          const pool =
            lastUrl && images.length > 1
              ? images.filter((i) => i.url !== lastUrl)
              : images;
          const item = pool[Math.floor(Math.random() * pool.length)];
          lastUrl = item.url;
          return item;
        }

        if (isMobile) {
          link.addEventListener("click", () => {
            hideMobileMedia();
            const item = pickRandom();
            if (!item) return;
            if (caption) caption.textContent = item.title || "";
            activeMobileMedia = placeMedia(item);
            activeMobileTimer = setTimeout(() => {
              hideMobileMedia();
              if (caption) caption.textContent = "";
            }, 6000);
          });
        } else {
          let mediaElem = null;
          link.addEventListener("mouseenter", () => {
            const item = pickRandom();
            if (!item) return;
            mediaElem = placeMedia(item);
            if (caption) caption.textContent = item.title || "";
          });
          link.addEventListener("mouseleave", () => {
            if (mediaElem) {
              hideMedia(mediaElem);
              mediaElem = null;
            }
            if (caption) caption.textContent = "";
          });
        }
      });
    </script>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const infoBtn = document.querySelector(".info-button");
        const infoPanel = document.querySelector(".info-panel");
        const closeBtn = document.querySelector(".info-close");
        const contentWrapper = document.querySelector(".home-inner");

        if (!infoBtn || !infoPanel || !closeBtn || !contentWrapper) return;

        let isOpen = false;

        function openPanel() {
          isOpen = true;
          infoPanel.classList.add("active");
          contentWrapper.classList.add("panel-open");
          infoBtn.classList.add("hidden");
        }

        function closePanel() {
          isOpen = false;
          infoPanel.classList.remove("active");
          contentWrapper.classList.remove("panel-open");
          infoBtn.classList.remove("hidden");
        }

        infoBtn.addEventListener("click", () => {
          if (isOpen) closePanel();
          else openPanel();
        });

        closeBtn.addEventListener("click", closePanel);
      });
    </script>
  </section>
</BaseLayout>
