---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { client, urlFor } from "../../lib/sanity";
import "swiper/swiper-bundle.css";

const getImageSrc = (it, width = 1800) => {
  if (!it) return null
  if (it.asset && it.asset.url) return it.asset.url
  try {
    if (it._type === 'image') return urlFor(it).width(width).quality(90).auto('format').url()
    if (it.asset && it.asset._ref) return urlFor({asset: it.asset}).width(width).quality(90).auto('format').url()
    if (it.asset) return urlFor(it.asset).width(width).quality(90).auto('format').url()
  } catch (e) {
    return null
  }
  return null
}

const getBlurPlaceholderFit = (displayMode = 'fullscreen', layout = 'single') => {
  if (layout === 'two-up' || layout === 'grid') return 'cover'
  return displayMode === 'fullscreen' ? 'cover' : 'contain'
}


export async function getStaticPaths() {
  const works = await client.fetch(`*[_type == "work" && defined(slug.current)]{
    "slug": slug.current
  }`);
  return works.map(work => ({
    params: { slug: work.slug },
  }));
}

const { slug } = Astro.params;
const work = await client.fetch(
  `*[_type == "work" && slug.current == $slug][0]{
    ...,
gallery[]{
  _type,
  "isVideo": _type in ["file", "video"],
  "displayMode": coalesce(displayMode, "fullscreen"),
  "videoUrl": select(_type in ["file", "video"] => asset->url, null),
  asset,
  "lqip": asset->metadata.lqip,
  "width": asset->metadata.dimensions.width,
  "height": asset->metadata.dimensions.height,
  // slide shape (new)
  layout,
  items[]{
    _type,
    "isVideo": _type in ["file", "video"],
    "displayMode": coalesce(displayMode, "fullscreen"),
    "videoUrl": select(_type in ["file", "video"] => asset->url, null),
    asset,
    "lqip": asset->metadata.lqip,
    "width": asset->metadata.dimensions.width,
    "height": asset->metadata.dimensions.height
  }
}
  }`,
  { slug }
);
---
<BaseLayout title={work.quote}>
  <div class="page-wrapper"> 
  <div class="work-detail difference" onclick="window.location.href='/works'">
    <h1>{work.title}</h1>
      </div>

    <!-- Swiper -->
{work.gallery && work.gallery.length > 0 && (
  <div class="swiper fullscreen-swiper">
    <div class="swiper-wrapper">
      {(() => {
        // normalize gallery into slides: each slide has { layout, items: [...] }
        const slides = (work.gallery || []).map((entry) => {
          if (entry._type === 'gallerySlide' || entry.items) {
            const items = (entry.items || []).map((it) => ({
              ...it,
              displayMode: it.displayMode || 'fullscreen',
              isVideo: !!it.isVideo || it._type === 'file' || it._type === 'video',
              videoUrl: it.videoUrl || it.asset?.url,
            }))
            return { layout: entry.layout || 'single', items }
          }
          // old single item shape
          const item = {
            ...entry,
            displayMode: entry.displayMode || 'fullscreen',
            isVideo: !!entry.isVideo || entry._type === 'file' || entry._type === 'video',
            videoUrl: entry.videoUrl || entry.asset?.url,
          }
          return { layout: 'single', items: [item] }
        })

        return slides.map((slide) => (
          <div class="swiper-slide">
            {slide.layout === 'two-up' || slide.layout === 'grid' ? (
              <div class={`slide-grid slide-grid--${slide.layout}`}>
                {slide.items.map((it) => (
                    it && it.isVideo ? (
                      <video
                        playsinline
                        preload="metadata"
                        muted
                        autoplay
                        loop
                        class={`gallery-video gallery-video--${it.displayMode === 'inset' ? 'inset' : it.displayMode === 'contained' ? 'contained' : 'fullscreen'}`}
                      >
                        <source src={it.videoUrl || it.asset?.url} type="video/mp4" />
                      </video>
                    ) : it ? (
                      <img src={getImageSrc(it, 1800)} alt={it.caption || work.title} loading="lazy" class={`blur-up gallery-image--${it.displayMode === 'inset' ? 'inset' : it.displayMode === 'contained' ? 'contained' : 'fullscreen'}`} style={it.lqip ? `background-image:url(${it.lqip});background-size:${getBlurPlaceholderFit(it.displayMode, slide.layout)};background-position:center;background-repeat:no-repeat;` : ''} />
                    ) : null
                ))}
              </div>
            ) : (
              // single layout: show first item prominently
              (() => {
                const it = slide.items && slide.items[0];
                if (!it) return null;
                return it.isVideo ? (
                  <video
                    playsinline
                    preload="metadata"
                    muted
                    autoplay
                    loop
                    class={`gallery-video gallery-video--${it.displayMode === 'inset' ? 'inset' : it.displayMode === 'contained' ? 'contained' : 'fullscreen'}`}
                  >
                    <source src={it.videoUrl || it.asset?.url} type="video/mp4" />
                  </video>
                ) : (
                  <img src={getImageSrc(it, 2400)} alt={it.caption || work.title} loading="lazy" class={`blur-up gallery-image--${it.displayMode === 'inset' ? 'inset' : it.displayMode === 'contained' ? 'contained' : 'fullscreen'}`} style={it.lqip ? `background-image:url(${it.lqip});background-size:${getBlurPlaceholderFit(it.displayMode, slide.layout)};background-position:center;background-repeat:no-repeat;` : ''} data-width={it.width || it.asset?.width || ''} data-height={it.height || it.asset?.height || ''} />
                );
              })()
            )}
          </div>
        ))
      })()}
    </div>
    <div class="swiper-button-next"></div>
    <div class="swiper-button-prev"></div>
    <div class="swiper-pagination"></div>
  </div>
)}
    </div>


</div>


<!-- Load Swiper FIRST -->
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>

<!-- Initialize Swiper AFTER it's loaded -->
<script is:inline>
  window.addEventListener("load", () => {
    if (typeof Swiper === "undefined") {
      console.error("Swiper not loaded");
      return;
    }

    const swiperEl = document.querySelector(".fullscreen-swiper");
    if (!swiperEl) return;

    const swiper = new Swiper(swiperEl, {
      loop: false,
      rewind: true,
      effect: "slide",
      speed: 400,
      spaceBetween: 4,
      freeMode: true,
      slidesPerView: "auto",
      centeredSlides: true,
      fadeEffect: { crossFade: true },
      navigation: {
        nextEl: ".swiper-button-next",
        prevEl: ".swiper-button-prev",
      },
      keyboard: { enabled: true },
    });
  });
</script>

 
</BaseLayout>